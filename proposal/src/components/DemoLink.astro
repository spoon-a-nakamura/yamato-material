---
import { deck } from '../deck.config';
/* ============================================================
   デモ（Webカタログ試作）へのリンク。
   ------------------------------------------------------------
   URLは原稿に書かず、deck.config.ts の demoUrl から組み立てます。
   公開先が変わっても原稿を触る必要がありません。

     <DemoLink>デモを開く</DemoLink>                    … トップ
     <DemoLink to="/products/">一覧のデモ</DemoLink>     … 任意のパス
     <DemoLink product>商品詳細のデモ</DemoLink>         … サンプル商品の詳細
     <DemoLink variant="button">…</DemoLink>            … 囲み付きで目立たせる

   variant="button" のときは先頭に画面のアイコンを添えます。
   文字のグリフ（↗）では書体によって形が変わり印刷でも崩れるため、
   インラインSVGにしています。色は currentColor で追従します。
   ============================================================ */
interface Props {
  /** デモ内のパス。省略するとトップ。 */
  to?: string;
  /** true にすると deck.demoSampleProduct の商品詳細へ。 */
  product?: boolean;
  /** "button" を渡すと囲み付きの表示になります。 */
  variant?: string;
}
const { to, product = false, variant = '' } = Astro.props;

const path = product ? `/products/${deck.demoSampleProduct}/` : (to ?? '/');
const href = `${deck.demoUrl.replace(/\/+$/, '')}/${String(path).replace(/^\/+/, '')}`;
const variants = variant ? variant.split(' ').filter(Boolean) : [];
const variantClass = variants.map((v) => `demolink--${v}`).join(' ');
const isButton = variants.includes('button');
---
<a
  class={`demolink ${variantClass}`}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-demo={path}
>
  {isButton && (
    <svg class="demolink__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="2.5" y="3.5" width="19" height="13" rx="1.6" />
      <path d="M8.5 20.5h7M12 16.5v4" />
    </svg>
  )}<slot />
</a>
