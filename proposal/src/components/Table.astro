---
interface Props {
  def?: boolean;      // 先頭列を見出し扱いにする定義表
  nohead?: boolean;   // ヘッダ行を持たない表
  zebra?: boolean;
  dense?: boolean;
  center?: boolean;   // 2列目以降を中央寄せ
  k?: string;         // 先頭列の幅（例: 34mm / 26%）
  class?: string;
}
const { def, nohead, zebra, dense, center, k, class: cls = '' } = Astro.props;
const classes = [
  def ? 't-def' : '',
  nohead ? 't-nohead' : '',
  zebra ? 't-zebra' : '',
  dense ? 't-dense' : '',
  center ? 't-center' : '',
  cls,
].filter(Boolean).join(' ');
---
<div class={classes} style={k ? `--k:${k}` : undefined}><slot /></div>
