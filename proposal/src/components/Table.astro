---
interface Props {
  def?: boolean;      // 先頭列を見出し扱いにする定義表
  nohead?: boolean;   // ヘッダ行を持たない表
  zebra?: boolean;
  dense?: boolean;
  center?: boolean;   // 2列目以降を中央寄せ
  right?: boolean;    // 最終列を右揃え（金額表）
  num?: boolean;      // 数字を等幅に揃える
  k?: string;         // 先頭列の幅（例: 34mm / 26%）
  class?: string;
}
const { def, nohead, zebra, dense, center, right, num, k, class: cls = '' } = Astro.props;
const classes = [
  def ? 't-def' : '',
  nohead ? 't-nohead' : '',
  zebra ? 't-zebra' : '',
  dense ? 't-dense' : '',
  center ? 't-center' : '',
  right ? 't-right' : '',
  num ? 't-num' : '',
  cls,
].filter(Boolean).join(' ');
---
<div class={classes} style={k ? `--k:${k}` : undefined}><slot /></div>
