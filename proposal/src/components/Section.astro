---
import { deck } from '../deck.config';
import Brand from './Brand.astro';
interface Props {
  no: string | number;
  title: string;
  lead?: string;
  items?: string[];
  /** 追加クラス。項目数が多く版面に収まらない章扉には "tight" を渡します。 */
  variant?: string;
}
const { no, title, lead, items = [], variant = '' } = Astro.props;
const variantClass = variant
  ? variant.split(' ').filter(Boolean).map((v) => `slide--${v}`).join(' ')
  : '';
const label = String(no).padStart(2, '0');
---
<section id={`part-${no}`} data-part={String(no)} class={`slide section ${variantClass}`}>
  <header class="slide__header">
    <div class="slide__chapter-label"></div>
    <Brand />
  </header>

  <div class="slide__body">
    <span class="section__eyebrow">PART {label}</span>
    <div class="section__no">{label}</div>
    <div class="section__rule"></div>
    <h2 class="section__title" set:html={title} />
    {lead && <p class="section__lead" set:html={lead} />}
    {items.length > 0 && (
      <div class="section__items">
        {items.map((it) => <span set:html={`— ${it}`} />)}
      </div>
    )}
  </div>

  <footer class="slide__footer">
    <span></span>
    <span class="slide__pageno"></span>
  </footer>
</section>
