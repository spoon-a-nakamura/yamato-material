---
interface Props { label?: string; title?: string; tone?: 'plain' | 'tint' | 'accent' | 'mark'; class?: string; }
const { label, title, tone = 'plain', class: cls = '' } = Astro.props;
---
<div class={`card ${tone !== 'plain' ? `card--${tone}` : ''} ${cls}`}>
  {label && <span class="card__label" set:html={label} />}
  {title && <p class="card__title" set:html={title} />}
  <slot />
</div>
